# Server Configuration
PORT=5000
NODE_ENV=development
LOG_LEVEL=info

# Database Configuration (MongoDB)
MONGODB_URI=mongodb://localhost:27017/nexus_workspace

# Cache Store Configuration (Redis)
REDIS_URL=redis://localhost:6379

# LiveKit Media Server Configuration
LIVEKIT_API_URL=https://livekit-server.nexus.io
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secretkey
LIVEKIT_TOKEN_TTL=4h

# CORS / Origin Configuration
CORS_ORIGIN=http://localhost:3000

# Authentication
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d

# Coturn STUN/TURN Server Configuration
TURN_STATIC_AUTH_SECRET=meetsphere-turn-static-auth-secret-2026-key
TURN_DOMAIN=turn.meetsphere.com
TURN_REALM=turn.meetsphere.com
TURN_PORT=3478
TURN_TLS_PORT=5349
TURN_TTL=86400

