# Root Environment Variables for Docker Compose Local Setup

# Backend Server Configuration
PORT=5000
NODE_ENV=development
LOG_LEVEL=info

# Database Configuration (Internal Docker Service)
MONGODB_URI=mongodb://mongodb:27017/nexus_workspace

# Cache Store Configuration (Internal Docker Service)
REDIS_URL=redis://redis:6379

# LiveKit Media Server Configuration (Dev Mode Keys)
LIVEKIT_API_URL=http://livekit:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secretkey
LIVEKIT_TOKEN_TTL=4h

# CORS / Origin Configuration
CORS_ORIGIN=http://localhost:3000

# Authentication Secrets
JWT_SECRET=dev-jwt-secret-key-meetsphere-2026
JWT_EXPIRES_IN=7d

# Coturn STUN/TURN Server Configuration
TURN_STATIC_AUTH_SECRET=meetsphere-turn-static-auth-secret-2026-key
TURN_DOMAIN=turn.meetsphere.com
TURN_REALM=turn.meetsphere.com
TURN_PORT=3478
TURN_TLS_PORT=5349
TURN_TTL=86400

# Frontend Vite Client Public Environment Variables
VITE_API_URL=http://localhost:5000
VITE_LIVEKIT_URL=ws://localhost:7880

